# USB serial bridge (copy to .env). Leave blank to auto-select one ESP32 candidate.
ESP32_SERIAL_PORT=COM7
ESP32_BAUD_RATE=115200
ESP32_RECONNECT_DELAY_MS=2000
ESP32_DATA_TIMEOUT_MS=1000
DIGITAL_TWIN_MOCK_MODE=false
WS_HOST=127.0.0.1
WS_PORT=8080
VITE_TELEMETRY_URL=ws://localhost:8080

# Raw servo degrees; align these with the receiver's existing safety limits.
JOINT_LIMITS={"base":[45,135],"shoulder":[40,140],"elbow":[45,135],"wrist":[45,135]}
# Model degrees = servo degrees * scale + offset. Use scale -1 for a reversed joint.
# Receiver startup: all servos 90 degrees -> model home: base 0, shoulder 90, elbow 90, wrist 0.
# Neutral sensor input: pitch 24, roll -1. Startup/home is defined in js/config.js.
JOINT_MAPPING={"base":{"scale":1,"offset":-90},"shoulder":{"scale":1,"offset":0},"elbow":{"scale":1,"offset":0},"wrist":{"scale":1,"offset":-90}}

# Development only: both settings are required to emit simulated data.
NODE_ENV=development
# Set DIGITAL_TWIN_MOCK_MODE=true above to enable simulated data.
# Legacy SERIAL_PORT, SERIAL_BAUD_RATE, SERIAL_RECONNECT_MS, STALE_AFTER_MS,
# and MOCK_MODE names are accepted when the corresponding new name is absent.
